# 32-byte key, base64 or hex encoded. Used to encrypt stored RPC URLs (AES-256-GCM).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
RPC_PULSE_SECRET_KEY=

# HTTP server
HOST=127.0.0.1
PORT=4000

# SQLite database file
DATABASE_PATH=./data/rpc-pulse.db

# Allow endpoints that resolve to private/loopback/link-local addresses (e.g. a local node).
# Disabled by default to prevent the server being used to reach internal networks.
ALLOW_PRIVATE_NETWORKS=false
